---
// src/layouts/layout.astro
import "../styles/global.css";
import SmoothScroll from "../components/common/SmoothScroll.astro";
import Navbar from "../components/common/Navbar.astro";
import MorphingTopo from "../components/common/MorphingTopo.tsx";

interface Props {
  title?: string;
  description?: string;
  backHref?: string;
}

const {
  title = "kyororoom",
  description = "Kyororoom - Portfolio and Blog",
  backHref,
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DotGothic16&display=swap" />
    <link rel="preload" as="image" href="/assets/Hero/Carousel/6.webp" type="image/webp" fetchpriority="high" />
  </head>
  <body class="bg-transparent text-spotify-textMain font-sans antialiased">
    <SmoothScroll />
    <MorphingTopo client:only="react" />
    <Navbar backHref={backHref} />
    <slot />
  </body>
</html>
