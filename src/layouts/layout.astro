---
import "../styles/global.css";
import Navbar from "../components/astro/Navbar.astro";
import MorphingTopo from "../components/react/Background/MorphingTopo.tsx";
import en
interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Kyororoom - Portfolio and Blog" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
    </head>
    <body class="bg-transparent text-spotify-textMain font-sans antialiased">
        <MorphingTopo client:only="react" />
        <Navbar />
        <slot />
    </body>
</html>
