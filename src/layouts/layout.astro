---
import "../styles/global.css";
import SmoothScroll from "../components/common/SmoothScroll.astro";
import Navbar from "../components/common/Navbar.astro";
import MorphingTopo from "../components/common/MorphingTopo.tsx";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Kyororoom - Portfolio and Blog" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/png" href="/icon.png" />
        <link rel="apple-touch-icon" href="/icon.png" />
        <title>{title}</title>
    </head>
    <body class="bg-transparent text-spotify-textMain font-sans antialiased">
        <SmoothScroll />
        <MorphingTopo client:only="react" />
        <Navbar />
        <slot />
    </body>
</html>
