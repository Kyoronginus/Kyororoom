---
// src/pages/art-trades.astro
export const prerender = true;

import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Layout from '../layouts/layout.astro';

// Import all images from src/assets/artgifts
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/artgifts/*.{png,jpg,jpeg,webp,PNG,JPG,JPEG}',
  { eager: true }
);

const images = Object.entries(imageModules).map(([path, mod]) => ({
  path,
  name: path.split('/').pop()?.replace(/\.[^/.]+$/, '') || '',
  data: mod.default,
}));
---

<Layout
  title="ART TRADES & GIFTS - KYOROROOM"
  description="Art trade and gift gallery for Kyoronginus."
  backHref="/#contact"
>
  <main class="trades-main">
      <header class="trades-header">
        <h1 class="page-title">ART TRADES & GIFTS</h1>
      </header>

      <div class="trades-grid">
        {images.map(({ data, name }) => (
          <div class="trade-card">
            <a href={data.src} target="_blank" rel="noopener noreferrer" class="trade-link" title={name}>
              <Image
                src={data}
                alt={name}
                width={800}
                quality={85}
                loading="lazy"
                class="trade-img"
              />
            </a>
          </div>
        ))}
      </div>
    </main>

    <footer class="footer text-center" style="margin-top: 60px; padding-bottom: 40px;">
      <p class="copyright">© 2026 Kyoronginus. All rights reserved.</p>
    </footer>
</Layout>

<style>
  .trades-main {
    max-width: var(--content-max-width);
    width: var(--content-width);
    margin: 0 auto;
    padding: 20px 0;
  }

  .trades-header {
    margin-bottom: 24px;
  }

  .page-title {
    font-size: var(--section-title-size);
    margin: 0.2em 0;
  }

  .trades-grid {
    columns: 3 320px;
    column-gap: 16px;
  }

  .trade-card {
    break-inside: avoid;
    margin-bottom: 16px;
    border: 1px solid #ccc;
    background: #fff;
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .trade-card:hover {
    border-color: #333;
    transform: translateY(-2px);
  }

  .trade-link {
    display: block;
    width: 100%;
    cursor: zoom-in;
  }

  .trade-img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 640px) {
    .trades-grid {
      columns: 2 150px;
      column-gap: 10px;
    }

    .trade-card {
      margin-bottom: 10px;
    }
  }
</style>
