---
// src/pages/works/index.astro
import MorphingTopo from '../../components/common/MorphingTopo';
import WorksGallery from '../../components/works/WorksGallery.astro';
import '../../styles/global.css';

const category = Astro.url.searchParams.get('category') || 'all';

// Cache on CDN in production, allow BFCache in development
if (import.meta.env.PROD) {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');
} else {
  Astro.response.headers.set('Cache-Control', 'no-cache, must-revalidate');
}
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WORKS - KYOROROOM</title>
    <meta name="description" content="Artwork gallery by Kyoronginus - Personal and Commission illustrations." />
  </head>
  <body>
    <MorphingTopo client:only="react" />

    <!-- Navbar -->
    <nav class="navbar">
      <div class="logo">
        <h2 class="my-0">
          <a href="/#works" id="work-back-btn">BACK</a>
        </h2>
      </div>
      <div class="nav-links">
        <a href="/#about">ABOUT</a>
        <a href="/#blog">BLOG</a>
        <a href="/#works">WORKS</a>
        <a href="/#projects">PROJECTS</a>
        <a href="/#contact">CONTACT</a>
      </div>
    </nav>

    <script is:inline>
      const backBtn = document.getElementById('work-back-btn');
      if (backBtn) {
        backBtn.addEventListener('click', (e) => {
          if (window.history.length > 1 && document.referrer && new URL(document.referrer).origin === window.location.origin) {
            e.preventDefault();
            window.history.back();
          }
        });
      }
    </script>

    <main class="works-page-main">
      <header class="works-page-header">
        <h1 class="page-title">WORKS</h1>
      </header>
      <WorksGallery isHome={false} initialCategory={category} />
    </main>
  </body>
</html>

<style>
  .logo a {
    text-decoration: none;
    color: inherit;
    transition: color 0.2s ease;
  }

  .logo a:hover {
    color: #37c13e;
  }

  .works-page-main {
    max-width: 1200px;
    width: 95%;
    margin: 30px auto 80px auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .works-page-header {
    margin-bottom: 10px;
  }

  .page-title {
    margin: 0;
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #111;
  }

  @media (max-width: 768px) {
    .works-page-main {
      margin-top: 20px;
    }
    .page-title {
      font-size: 1.8rem;
    }
  }
</style>
