---
// src/pages/works/index.astro
import Layout from '../../layouts/layout.astro';
import WorksGallery from '../../components/works/WorksGallery.astro';

const category = Astro.url.searchParams.get('category') || 'all';

// Cache on CDN in production, allow BFCache in development
if (import.meta.env.PROD) {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');
} else {
  Astro.response.headers.set('Cache-Control', 'no-cache, must-revalidate');
}
---

<Layout
  title="WORKS - KYOROROOM"
  description="Artwork gallery by Kyoronginus - Personal and Commission illustrations."
  backHref="/#works"
>
  <main class="works-page-main">
    <header class="works-page-header">
      <h1 class="page-title">WORKS</h1>
    </header>
    <WorksGallery isHome={false} initialCategory={category} />
  </main>
</Layout>

<style>
  .logo a {
    text-decoration: none;
    color: inherit;
    transition: color 0.2s ease;
  }

  .logo a:hover {
    color: #37c13e;
  }

  .works-page-main {
    max-width: 1200px;
    width: 95%;
    margin: 30px auto 80px auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .works-page-header {
    margin-bottom: 10px;
  }

  .page-title {
    margin: 0;
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #111;
  }

  @media (max-width: 768px) {
    .works-page-main {
      margin-top: 20px;
    }
    .page-title {
      font-size: 1.8rem;
    }
  }
</style>
