---
import "../styles/global.css";
import MorphingTopo from "../components/react/Background/MorphingTopo.tsx";
import Ticker from "../components/react/Hero/Ticker.tsx";
import HeroCarousel from "../components/react/Hero/HeroCarousel.tsx";
import AboutSection from "../components/astro/AboutSection.astro";
import MediaBanner from "../components/astro/MediaBanner.astro";
import VisitorCounter from "../components/react/Contact/VisitorCounter.tsx";
import PatreonBlog from "../components/react/Blog/PatreonBlog.tsx";
import PatronTicker from "../components/react/Hero/PatronTicker.tsx";
import WorksGallery from "../components/astro/WorksGallery.astro";
import { fetchLatestPosts, fetchActiveMembers } from "../lib/patreon";

const initialPosts = await fetchLatestPosts();
const initialMembers = await fetchActiveMembers();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <title>kyororoom</title>
  </head>
  <body>
    <MorphingTopo client:only="react" />
    <!-- Navbar -->
    <nav class="navbar">
      <div class="logo">
        <h2 class="my-0">
          <a href="#home">KYOROROOM</a>
        </h2>
      </div>
      <div class="nav-links">
        <a href="#about">ABOUT</a>
        <a href="#blog">BLOG</a>
        <a href="#works">WORKS</a>
        <a href="#projects">PROJECTS</a>
        <a href="#contact">CONTACT</a>
      </div>
    </nav>

    <!-- TICKER (流れる掲示板) -->
    <Ticker client:load />

    <!-- HOME (横スクロールギャラリー) -->
    <section id="home">
      <HeroCarousel client:load />
    </section>

    <main>
       <div class="banner-container flex flex-wrap gap-2">
        <MediaBanner type="image" src="/Assets/Hero/Video/Uchinoko Kawaii.gif" alt="Animated Banner" href="https://uchinokokawaii.netlify.app"/>
        <MediaBanner type="image" src="/Assets/Hero/Etc/idolized.png" alt="Static Banner" />
        <MediaBanner type="image" src="/Assets/Hero/Video/oekakusa.gif" alt="Animated Banner" href="https://github.com/Kyoronginus/oekakusa" />
        <!-- <MediaBanner type="image" src="/Assets/Hero/Etc/oekakusa.png" alt="Static Banner" /> -->
       </div>

      <!-- ABOUT -->
      <AboutSection />


      
      <!-- WORKS -->
      <section id="works">
        <h1>WORKS</h1>
        <WorksGallery limit={12} isHome={true} />
      </section>
      <!-- BLOG -->
      <section id="blog">
        <h1>BLOG</h1>
        <!-- PATREON TICKER -->
        <PatronTicker client:load initialMembers={initialMembers} />
        <PatreonBlog client:load initialPosts={initialPosts} />
      </section>
      
      <!-- PROJECTS -->
      <section id="projects">
        <!-- <h1>PROJECTS</h1>
        <div class="projects-grid">
          <div class="project-item">UCHINOKO KAWAII</div>
          <div class="project-item">
            FIBONACCI <span class="arrow">-></span>
          </div>
          <div class="project-item">OEKAKUSA</div>
          <div class="project-item">... <span class="arrow">-></span></div>
        </div> -->
      </section>

      <!-- CONTACTS -->
      <section id="contacts">
        <h1>CONTACTS</h1>
        <div class="contact-links">
          <div class="social-icon">X</div>
          <div class="social-icon">Discord server</div>
        </div>
        <div class="contact-badges">
          <button class="badge-btn">OC Gallery</button>
          <button class="badge-btn">...</button>
          <button class="badge-btn">...</button>
        </div>
        <div style="margin-top: 2rem; display: flex; ">
          <VisitorCounter client:load />
        </div>
      </section>
    </main>
  </body>
</html>
