---
import Layout from "../layouts/layout.astro";
import Ticker from "../components/hero/Ticker.tsx";
import HeroCarousel from "../components/hero/HeroCarousel.tsx";
import AboutSection from "../components/about/AboutSection.astro";
import MediaBanner from "../components/hero/MediaBanner.astro";
import ContactSection from "../components/contact/ContactSection.astro";
import PatreonBlog from "../components/blog/PatreonBlog.tsx";
import PatronTicker from "../components/hero/PatronTicker.tsx";
import WorksGallery from "../components/works/WorksGallery.astro";
import { fetchLatestPosts, fetchActiveMembers } from "../lib/patreon";
import { getOrIncrementViews } from "../lib/views";
import { siteConfig } from "../config/site";

const [initialPosts, initialMembers, initialViews] = await Promise.all([
  fetchLatestPosts(),
  fetchActiveMembers(),
  getOrIncrementViews(),
]);

const initialTickerData = {
  commission: {
    isOpen: siteConfig.commissions.isOpen,
    statusLabel: siteConfig.commissions.statusLabel,
  },
  latestPost: initialPosts && initialPosts.length > 0 ? {
    id: initialPosts[0].id,
    title: initialPosts[0].title,
    url: initialPosts[0].url,
    date: initialPosts[0].date,
  } : null,
  announcements: siteConfig.announcements || [],
};
---

<Layout title="kyororoom">
  <!-- TICKER  -->
  <Ticker initialData={initialTickerData} client:load />

    <!-- HOME -->
    <section id="home">
      <HeroCarousel client:load />
    </section>

    <main>
       <div class="banner-container flex flex-wrap gap-2">
        <MediaBanner type="image" src="/assets/Hero/Video/Uchinoko Kawaii.webp" alt="Animated Banner" href="https://uchinokokawaii.netlify.app"/>
        <MediaBanner type="image" src="/assets/Hero/Video/oekakusa.webp" alt="Animated Banner" href="https://github.com/Kyoronginus/oekakusa" />
        <MediaBanner type="image" src="/assets/Hero/Video/fibonacci.webp" alt="Animated Banner" href="https://fibonacci-spiral-detecti-bf743.web.app/" />
        <MediaBanner type="image" src="/assets/Hero/Etc/idolized.webp" alt="Static Banner" />
        <!-- <MediaBanner type="image" src="/assets/Hero/Etc/oekakusa.png" alt="Static Banner" /> -->
       </div>

      <!-- ABOUT -->
      <AboutSection />


      
      <!-- WORKS -->
      <section id="works">
        <h1>WORKS</h1>
        <WorksGallery limit={12} isHome={true} />
      </section>
      <!-- BLOG -->
      <section id="blog">
        <h1>BLOG</h1>
        <!-- PATREON TICKER -->
        <PatronTicker client:visible initialMembers={initialMembers} />
        <PatreonBlog client:visible initialPosts={initialPosts} />
      </section>
      
      <!-- PROJECTS -->
      <section id="projects">
        <!-- <h1>PROJECTS</h1>
        <div class="projects-grid">
          <div class="project-item">UCHINOKO KAWAII</div>
          <div class="project-item">
            FIBONACCI <span class="arrow">-></span>
          </div>
          <div class="project-item">OEKAKUSA</div>
          <div class="project-item">... <span class="arrow">-></span></div>
        </div> -->
      </section>

      <!-- CONTACTS -->
      <ContactSection initialViews={initialViews} />

      <footer class="footer text-center">
        <p class="copyright">© 2026 Kyoronginus. All rights reserved.</p>
      </footer>
    </main>

    <script>
      import { setupScrollspy } from '../utils/scrollspy';
      setupScrollspy();
      document.addEventListener('astro:page-load', setupScrollspy);
    </script>
</Layout>
