---
import "../styles/global.css";
import MorphingTopo from "../components/common/MorphingTopo.tsx";
import Ticker from "../components/hero/Ticker.tsx";
import HeroCarousel from "../components/hero/HeroCarousel.tsx";
import AboutSection from "../components/about/AboutSection.astro";
import MediaBanner from "../components/hero/MediaBanner.astro";
import ContactSection from "../components/contact/ContactSection.astro";
import PatreonBlog from "../components/blog/PatreonBlog.tsx";
import PatronTicker from "../components/hero/PatronTicker.tsx";
import WorksGallery from "../components/works/WorksGallery.astro";
import { fetchLatestPosts, fetchActiveMembers } from "../lib/patreon";

const initialPosts = await fetchLatestPosts();
const initialMembers = await fetchActiveMembers();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <title>kyororoom</title>
  </head>
  <body>
    <MorphingTopo client:only="react" />
    <!-- Navbar -->
    <nav class="navbar">
      <div class="logo">
        <h2 class="my-0">
          <a href="#home">KYOROROOM</a>
        </h2>
      </div>
      <div class="nav-links">
        <a href="#about">ABOUT</a>
        <a href="#works">WORKS</a>
        <a href="#blog">BLOG</a>
        <a href="#contact">CONTACT</a>
      </div>
    </nav>

    <!-- TICKER (流れる掲示板) -->
    <Ticker client:load />

    <!-- HOME (横スクロールギャラリー) -->
    <section id="home">
      <HeroCarousel client:load />
    </section>

    <main>
       <div class="banner-container flex flex-wrap gap-2">
        <MediaBanner type="image" src="/assets/Hero/Video/Uchinoko Kawaii.gif" alt="Animated Banner" href="https://uchinokokawaii.netlify.app"/>
        <MediaBanner type="image" src="/assets/Hero/Video/oekakusa.gif" alt="Animated Banner" href="https://github.com/Kyoronginus/oekakusa" />
        <MediaBanner type="image" src="/assets/Hero/Video/fibonacci.gif" alt="Animated Banner" href="https://fibonacci-spiral-detecti-bf743.web.app/" />
        <MediaBanner type="image" src="/assets/Hero/Etc/idolized.png" alt="Static Banner" />
        <!-- <MediaBanner type="image" src="/assets/Hero/Etc/oekakusa.png" alt="Static Banner" /> -->
       </div>

      <!-- ABOUT -->
      <AboutSection />


      
      <!-- WORKS -->
      <section id="works">
        <h1>WORKS</h1>
        <WorksGallery limit={12} isHome={true} />
      </section>
      <!-- BLOG -->
      <section id="blog">
        <h1>BLOG</h1>
        <!-- PATREON TICKER -->
        <PatronTicker client:load initialMembers={initialMembers} />
        <PatreonBlog client:load initialPosts={initialPosts} />
      </section>
      
      <!-- PROJECTS -->
      <section id="projects">
        <!-- <h1>PROJECTS</h1>
        <div class="projects-grid">
          <div class="project-item">UCHINOKO KAWAII</div>
          <div class="project-item">
            FIBONACCI <span class="arrow">-></span>
          </div>
          <div class="project-item">OEKAKUSA</div>
          <div class="project-item">... <span class="arrow">-></span></div>
        </div> -->
      </section>

      <!-- CONTACTS -->
      <ContactSection />
    </main>

    <script>
      import { setupScrollspy } from '../utils/scrollspy';
      setupScrollspy();
      document.addEventListener('astro:page-load', setupScrollspy);
    </script>
  </body>
</html>
