---
// src/components/common/SmoothScroll.astro
---

<script>
  import Lenis from 'lenis';

  // Initialize or retrieve singleton Lenis instance
  function initLenis(): Lenis {
    if ((window as any).__lenisInstance) {
      return (window as any).__lenisInstance;
    }

    const lenis = new Lenis({
      autoRaf: true,
      anchors: true,
      smoothWheel: true,
      duration: 1.2,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      wheelMultiplier: 1.0,
      touchMultiplier: 1.5,
      infinite: false,
      respectReducedMotion: true,
    });

    (window as any).__lenisInstance = lenis;
    (window as any).lenis = lenis;

    // Handle same-page anchor link clicks with Lenis smooth scroll
    document.addEventListener('click', (e) => {
      const anchor = (e.target as HTMLElement)?.closest('a');
      if (!anchor) return;
      const href = anchor.getAttribute('href');
      if (!href) return;

      // In-page hash anchor (e.g. #about)
      if (href.startsWith('#') && href.length > 1) {
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          lenis.scrollTo(target as HTMLElement);
          history.pushState(null, '', href);
        }
      }
    });

    // Handle hash on page load (e.g. navigating from /works to /#works)
    if (window.location.hash) {
      setTimeout(() => {
        try {
          const target = document.querySelector(window.location.hash);
          if (target) {
            lenis.scrollTo(target as HTMLElement);
          }
        } catch {
          // Ignore invalid selector
        }
      }, 150);
    }

    return lenis;
  }

  // Ensure Lenis runs on initial load
  initLenis();
</script>
