---
// src/components/common/Navbar.astro
import { Image } from 'astro:assets';
import titleSvg from '../../assets/title.svg';

interface Props {
  backHref?: string;
  logoHref?: string;
}

const { backHref, logoHref } = Astro.props;
const isHome = Astro.url.pathname === '/';
const defaultLogoHref = isHome ? '#home' : '/#home';
const effectiveLogoHref = logoHref || defaultLogoHref;
---

<nav class="navbar">
  <div class="logo">
    <div class="logo-title my-0">
      {backHref ? (
        <a href={backHref} id="nav-back-btn">&larr; BACK</a>
      ) : (
        <a href={effectiveLogoHref} class="logo-img-link" aria-label="KYOROROOM Home">
          <Image
            src={titleSvg}
            alt="KYOROROOM"
            height={44}
            class="logo-img"
            loading="eager"
          />
        </a>
      )}
    </div>
  </div>
  <div class="nav-links">
    <a href={isHome ? '#about' : '/#about'}>ABOUT</a>
    <a href={isHome ? '#works' : '/#works'}>WORKS</a>
    <a href={isHome ? '#blog' : '/#blog'}>BLOG</a>
    <a href={isHome ? '#contact' : '/#contact'}>CONTACT</a>
  </div>
</nav>

<style>
  .logo-title {
    font-size: 1.2rem;
    font-weight: bold;
    text-transform: uppercase;
    display: flex;
    align-items: center;
  }
  .logo a {
    text-decoration: none;
    color: inherit;
    transition: color 0.2s ease;
    display: flex;
    align-items: center;
  }
  .logo a:hover {
    color: #111;
  }
  .logo-img-link {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }
  .logo-img {
    height: 44px;
    width: auto;
    object-fit: contain;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .logo-img-link:hover .logo-img {
    opacity: 0.85;
    transform: scale(1.02);
  }
</style>
