---
// src/components/common/Navbar.astro
interface Props {
  backHref?: string;
  logoHref?: string;
}

const { backHref, logoHref } = Astro.props;
const isHome = Astro.url.pathname === '/';
const defaultLogoHref = isHome ? '#home' : '/#home';
const effectiveLogoHref = logoHref || defaultLogoHref;
---

<nav class="navbar">
  <div class="logo">
    <div class="logo-title my-0">
      {backHref ? (
        <a href={backHref} id="nav-back-btn">BACK</a>
      ) : (
        <a href={effectiveLogoHref}>KYOROROOM</a>
      )}
    </div>
  </div>
  <div class="nav-links">
    <a href={isHome ? '#about' : '/#about'}>ABOUT</a>
    <a href={isHome ? '#works' : '/#works'}>WORKS</a>
    <a href={isHome ? '#blog' : '/#blog'}>BLOG</a>
    <a href={isHome ? '#contact' : '/#contact'}>CONTACT</a>
  </div>
</nav>

<style>
  .logo-title {
    font-size: 1.2rem;
    font-weight: bold;
    text-transform: uppercase;
  }
  .logo a {
    text-decoration: none;
    color: inherit;
    transition: color 0.2s ease;
  }
  .logo a:hover {
    color: #111;
  }
</style>
