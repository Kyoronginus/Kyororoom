---
// src/components/astro/MediaBanner.astro
export interface Props {
  type: 'video' | 'image';
  src: string;
  alt?: string;
}

const { type, src, alt = "Media Banner" } = Astro.props;
---
<section class="media-banner-section">
  {type === 'video' ? (
    <video 
      class="media-banner"
      src={src} 
      autoplay 
      loop 
      muted 
      playsinline
    ></video>
  ) : (
    <img 
      class="media-banner"
      src={src} 
      alt={alt}
    />
  )}
</section>

<style>
  .media-banner-section {
    width: 300px;
    height: 110px;
    flex: 0 0 auto;
    border: 1px #d1d1d1 solid;
    overflow: hidden;
  }
  
  .media-banner {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    background-color: #eaeaea; 
  }
</style>
